(int, int) $global_getProposalState(((int, int)) $prop) impure inline {
    var ((($prop'data'proposalId, $prop'data'votingEndingAt))) = $prop;
    int $totalCount = 0;
    int $i = 0;
    int $yesCount = ($prop'data'proposalId & 15);
    int $votesShard = ($prop'data'proposalId >> 4);
    while (($votesShard)) {
        if ((($votesShard & 1) == 1)) {
            $totalCount = $totalCount + 1;
        }
        $votesShard = $votesShard >> 1;
    }
    return $ProposalState$_constructor_yesCount_noCount($yesCount, ($totalCount - $yesCount));
}

(((int, int)), (int, int)) $Proposal$_fun_proposalState(((int, int)) $self) impure inline {
    var ((($self'data'proposalId, $self'data'votingEndingAt))) = $self;
    var $fresh$ret_9 = $global_getProposalState((($self'data'proposalId, $self'data'votingEndingAt)));
    return ((($self'data'proposalId, $self'data'votingEndingAt)), $fresh$ret_9);
}

